{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website of Ruslan Khasanshin (hu553in).",
  "homepage": "https://hu553in.su",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/personal-website",
  "type": "module",
  "scripts": {
    "dev": "bun build:registry && next dev",
    "build": "bun build:registry && next build",
    "build:og-fonts": "bash scripts/build-og-fonts.sh",
    "build:registry": "shadcn build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "bun run test --coverage",
    "lint": "ultracite check && stylelint --max-warnings 0 --ignore-path .gitignore 'app/**/*.css' && shfmt -d scripts/*.sh && bunx shellcheck scripts/*.sh",
    "lint:fix": "ultracite fix && stylelint --max-warnings 0 --fix --ignore-path .gitignore 'app/**/*.css' && shfmt -w scripts/*.sh",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx github-actionlint",
    "check:renovate": "bunx --package renovate renovate-config-validator --strict --no-global renovate.json",
    "check:types": "rm -rf .next/types .next/dev/types && next typegen && tsc --pretty",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check": "bun lint && bun check:hooks && bun check:workflows && bun check:renovate && bun check:types && bun run build && bun check:unused && bun check:vulns && bun test:coverage",
    "check:fix": "bun lint:fix && bun check",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@shikijs/core": "^4.4.3",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "cn": "^0.2.4",
    "cuelume": "^0.2.2",
    "lucide-react": "^1.39.0",
    "modern-screenshot": "^4.7.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.3.3",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^20.13.1",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "shadcn": "^4.20.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.7",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "sharp"
  ]
}
