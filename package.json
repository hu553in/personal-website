{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website of Ruslan Khasanshin (hu553in).",
  "homepage": "https://hu553in.su",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/personal-website",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "ultracite check && stylelint --max-warnings 0 --ignore-path .gitignore 'app/**/*.css'",
    "lint:fix": "ultracite fix && stylelint --max-warnings 0 --fix --ignore-path .gitignore 'app/**/*.css'",
    "check:workflows": "bunx github-actionlint",
    "check:types": "rm -rf .next/types .next/dev/types && next typegen && tsc --pretty",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check": "bun lint && bun check:workflows && bun check:types && bun run build && bun check:unused && bun check:vulns",
    "check:fix": "bun lint:fix && bun check",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.0"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "sharp"
  ]
}
