{
  "name": "personal-website",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website of Ruslan Khasanshin (hu553in).",
  "homepage": "https://hu553in.dev",
  "author": "Ruslan Khasanshin",
  "repository": "https://github.com/hu553in/personal-website",
  "type": "module",
  "scripts": {
    "dev": "bun build:registry && vite dev",
    "build": "bun build:registry && cf build",
    "build:og-fonts": "bash scripts/build-og-fonts.sh",
    "build:registry": "shadcn build",
    "start": "vite preview",
    "deploy": "bun build:registry && vinext-cloudflare deploy",
    "test": "vitest run",
    "test:coverage": "bun run test --coverage",
    "lint": "bun fmt --check && oxlint && stylelint --max-warnings 0 --ignore-path .gitignore 'app/**/*.css' && shfmt -d scripts/*.sh && bunx --minimum-release-age 259200 shellcheck scripts/*.sh",
    "lint:fix": "oxlint --fix || oxlint --fix; bun fmt && oxlint && stylelint --max-warnings 0 --fix --ignore-path .gitignore 'app/**/*.css' && shfmt -w scripts/*.sh",
    "check:hooks": "lefthook validate",
    "check:workflows": "bunx --minimum-release-age 259200 github-actionlint",
    "check:types": "vinext typegen && bun check",
    "check:unused": "knip",
    "check:vulns": "bun audit --prod --audit-level=high",
    "check:e2e": "bun playwright:install && bun run build && playwright test --project chromium",
    "check:all": "bun lint && bun check:hooks && bun check:workflows && bun check:types && bun check:unused && bun check:vulns && bun test:coverage && bun check:e2e",
    "check:fix": "bun lint:fix && bun check:all",
    "playwright:install": "playwright install chromium",
    "prepare": "if [ -n \"${CI:-}\" ] || [ \"${LEFTHOOK:-}\" = \"0\" ]; then exit 0; fi; lefthook install"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@shikijs/core": "^4.6.0",
    "@shikijs/engine-javascript": "^4.6.0",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@vinext/cloudflare": "^1.4.0",
    "cn": "^0.5.2",
    "cuelume": "^0.2.8",
    "lucide-react": "^1.77.0",
    "modern-screenshot": "^4.7.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hotkeys-hook": "^5.4.0",
    "react-icons": "^5.7.0",
    "react-server-dom-webpack": "^19.3.1",
    "vinext": "^1.4.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-rc.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "@vitest/coverage-v8": "^5.1.1",
    "cf": "1.0.0-rc.2",
    "happy-dom": "^21.0.4",
    "knip": "^6.47.0",
    "lefthook": "^2.2.2",
    "next": "^16.4.6",
    "oxc-transform-react": "^0.158.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "shadcn": "^4.23.0",
    "stylelint": "^18.1.0",
    "stylelint-config-recommended": "^19.1.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.5",
    "ultracite": "^8.3.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "^11.0.9"
    },
    "satori": {
      "fflate": "^0.7.5"
    }
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || ^26.12.0"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "sharp"
  ]
}
